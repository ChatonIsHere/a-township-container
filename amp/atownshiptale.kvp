Meta.ConfigRoot=atownshiptale.kvp
Meta.MinAMPVersion=2.5.1.8
Meta.SpecificDockerImage=ghcr.io/chatonishere/a-township-container:latest-amp
Meta.DockerRequired=True
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Required
