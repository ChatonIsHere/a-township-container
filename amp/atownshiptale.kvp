App.DisplayName=A Township Tale
App.RootDir=./atownshiptale/
App.BaseDirectory=./atownshiptale/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=
App.ExecutableLinux=/att-launch.sh
App.WorkingDir=
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.UpdateSources=[]
App.EnvironmentVariables={"SERVER_PORT":"{{$ServerPort}}","AUTO_PATCH":"{{AutoPatch}}","DEBUG":"{{DebugHelper}}","ATT_ACCESS_TOKEN":"{{AccessToken}}","ATT_REFRESH_TOKEN":"{{RefreshToken}}","ATT_IDENTITY_TOKEN":"{{IdentityToken}}"}
App.CommandLineParameterFormat={0} "{1}"
App.CommandLineParameterDelimiter=
App.ExitMethod=OS_CLOSE
App.ExitTimeout=60
App.ExitString=
App.ExitFile=
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=[{"Protocol":"Both","Port":1757,"Ref":"ServerPort","Name":"Game Port"},{"Protocol":"Both","Port":1760,"Ref":"RconPort","Name":"RCON Port"},{"Protocol":"Both","Port":1761,"Ref":"ForestPort","Name":"Forest Port"},{"Protocol":"Both","Port":1762,"Ref":"AuthPort","Name":"Authentication Port"}]
App.AdminPortRef=0
App.UniversalSleepApplicationUDPPortRef=ServerPort
App.MaxUsers=8
App.UseRandomAdminPassword=False
App.AdminMethod=STDIO
App.ApplicationReadyMode=RegexMatch
