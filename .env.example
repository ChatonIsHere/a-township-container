# See the README's Settings section.
# SERVER_PORT=1757
# Console, web server and login. See docs/srv-records.md
# RCON_PORT=1760
# WEB_PORT=1761
# AUTH_PORT=1762
# AUTO_PATCH=true
# normal, quest or tutorial. Unset keeps whatever server_settings.json says
# SCENE=normal
# DEBUG=false
# Mods to keep installed, comma-separated: Author.Mod or Author.Mod@1.2.0
# MODLIST=
# User and group the server runs as. Unset means whoever owns game-source
# PUID=1000
# PGID=1000

# ATT_ACCESS_TOKEN=
# ATT_REFRESH_TOKEN=
# ATT_IDENTITY_TOKEN=
