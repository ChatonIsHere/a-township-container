Meta.DisplayName=A Township Tale
Meta.Description=A Township Tale server using The Modding Tavern's server implementation
Meta.OS=Linux
Meta.AarchSupport=None
Meta.Arch=x86_64
Meta.Author=ethan@ehsawyer.uk
Meta.URL=https://github.com/ChatonIsHere/a-township-container
Meta.DisplayImageSource=url:https://raw.githubusercontent.com/ChatonIsHere/a-township-container/amp-templates/att.jpg
Meta.EndpointURIFormat={ip}:{GenericModule.App.Ports.$ServerPort}
Meta.ConfigManifest=atownshiptaleconfig.json
Meta.MetaConfigManifest=atownshiptalemetaconfig.json
Meta.ConfigRoot=atownshiptale.kvp
Meta.MinAMPVersion=2.5.1.8
Meta.SpecificDockerImage=ghcr.io/chatonishere/a-township-container:latest-amp
Meta.DockerRequired=True
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Required
Meta.ContainerPolicyReason=The server runs through the wine setup and auto-patcher baked into the container image
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ExtraSetupStepsURI=
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.ImportableExtensions=[]
Meta.AppConfigId=d65294c5-e323-4e01-b8aa-0831e3bd4cc4
App.DisplayName=A Township Tale
App.RootDir=./atownshiptale/
App.BaseDirectory=./atownshiptale/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=
App.ExecutableLinux=/att-launch.sh
App.WorkingDir=
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=
App.UseLinuxIOREDIR=False
# wine launches the game through start.exe and the game reparents out of this script's process
# tree entirely (the same reason att-launch.sh has to stop it by name), so neither the direct
# child nor the child tree ever contains it - AMP reads ~0 CPU/memory either way. Find the game
# by matching its command line instead, the way the stock wine/proton templates do. The pattern
# is anchored on the wine drive path because the start.exe stub keeps the exe name in its own
# command line ("start.exe /exec A Township Tale.exe ...") and launches first - a bare-name
# match latches onto that idle stub and still reads zero
App.MonitorDirectChildOnly=False
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=^Z:\\.*A Township Tale\.exe.*$
App.AppSettings={}
App.UpdateSources=[]
App.EnvironmentVariables={"SERVER_PORT":"{{$ServerPort}}","AUTO_PATCH":"{{AutoPatch}}","DEBUG":"{{DebugHelper}}","RCON_PORT":"{{$RconPort}}","ATT_ACCESS_TOKEN":"{{AccessToken}}","ATT_REFRESH_TOKEN":"{{RefreshToken}}","ATT_IDENTITY_TOKEN":"{{IdentityToken}}"}
App.CommandLineParameterFormat={0} "{1}"
App.CommandLineParameterDelimiter=
App.ExitMethod=OS_CLOSE
App.ExitTimeout=60
App.ExitString=
App.ExitFile=
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=[{"Protocol":"Both","Port":1757,"Ref":"ServerPort","Name":"Game Port"},{"Protocol":"Both","Port":1760,"Ref":"RconPort","Name":"RCON Port"},{"Protocol":"Both","Port":1761,"Ref":"ForestPort","Name":"Forest Port"},{"Protocol":"Both","Port":1762,"Ref":"AuthPort","Name":"Authentication Port"}]
App.AdminPortRef=0
App.UniversalSleepApplicationUDPPortRef=ServerPort
App.MaxUsers=8
App.UseRandomAdminPassword=False
App.AdminMethod=STDIO
App.ApplicationReadyMode=RegexMatch
Console.AppReadyRegex=^(?!> ).*Starting auth listening cycle.*$
Console.FilterMatchRegex=
Console.ThrowawayMessageRegex=
Console.UserJoinRegex=^(?!> ).*User at .+ joining server.*$
Console.UserLeaveRegex=
Console.UserChatRegex=
Console.UpdateAvailableRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Limits.AutoRetryCount=0
Limits.SleepMode=False
Limits.SleepOnStart=False
